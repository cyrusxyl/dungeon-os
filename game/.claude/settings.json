{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Edit(./campaigns/**)",
      "Write(./campaigns/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$DUNGEON_STAGE_LOG\" ] || python3 \"$DUNGEON_STAGE_HOOK\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$DUNGEON_STAGE_LOG\" ] || python3 \"$DUNGEON_STAGE_HOOK\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$DUNGEON_STAGE_LOG\" ] || python3 \"$DUNGEON_STAGE_HOOK\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$DUNGEON_STAGE_LOG\" ] || python3 \"$DUNGEON_STAGE_HOOK\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$DUNGEON_STAGE_LOG\" ] || python3 \"$DUNGEON_STAGE_HOOK\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
